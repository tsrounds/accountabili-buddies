# Anthropic — powers the daily roasts + weekly dispatch recap.
# Client-side key (this is a private friend-group app; the key ships in the
# bundle by design). Without it the app falls back to canned roast templates.
VITE_ANTHROPIC_API_KEY=

# FCM Web Push VAPID public key. Grab it from Firebase Console →
# Project Settings → Cloud Messaging → Web configuration → generate key pair.
# Without it, the "Enable notifications" button reports push as unsupported.
VITE_FCM_VAPID_KEY=

# Firebase config is hardcoded in src/lib/firebase.ts (shared
# bracket-anything project) — no env vars needed for it.
