# Anthropic — powers AB's AI roasts via the /api/roast serverless function.
# Set this in your Vercel project (Settings → Environment Variables).
# Without it, the app gracefully falls back to local roast templates.
ANTHROPIC_API_KEY=

# Optional: override the model used for roasts (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Firebase config is currently hardcoded in src/lib/firebase.ts (shared
# bracket-anything project), so no NEXT_PUBLIC_FIREBASE_* vars are needed here.
